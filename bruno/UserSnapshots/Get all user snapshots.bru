meta {
  name: Get all user snapshots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/usersnapshots
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has one record per user, each with an Auth0 id and email", function () {
    const users = res.getBody();
    expect(users).to.be.an("array").that.is.not.empty;
    const ids = users.map(u => u.userId);
    expect(new Set(ids).size).to.equal(ids.length);
    for (const user of users) {
      expect(user.userId).to.match(/^auth0\|/);
      expect(user.email).to.be.a("string").and.not.be.empty;
    }
  });
}
